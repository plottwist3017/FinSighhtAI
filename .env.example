# ── OpenAI-compatible LLM ────────────────────────────────────────────────────
# Option A — OpenAI (default)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Option B — Groq  (paste your key from https://console.groq.com)
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama3-70b-8192
# Current recommended Groq models (llama3-8b-8192 is decommissioned):
#   llama3-70b-8192  |  llama-3.1-8b-instant  |  mixtral-8x7b-32768

# ── Monad Testnet (fill in when ready for blockchain integration) ─────────────
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
CONTRACT_ADDRESS=
PRIVATE_KEY=
WALLET_ADDRESS=
